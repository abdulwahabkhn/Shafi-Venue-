{
  "name": "shafi-marquee-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Shafi Complex & Marquee online management desktop app",
  "author": "Shafi Complex & Marquee",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64 --publish never",
    "build:signed": "electron-builder --win nsis --x64 --publish never -c.forceCodeSigning=true -c.directories.output=release-signed",
    "test": "node --test policy.test.cjs main.test.cjs"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.shafimarquee.management",
    "productName": "Shafi Marquee",
    "asar": true,
    "files": ["main.cjs", "policy.cjs", "package.json"],
    "directories": {"output": "release"},
    "win": {"target": "nsis"},
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": false,
      "artifactName": "Shafi-Marquee-Setup-${version}-${arch}.${ext}"
    }
  }
}
